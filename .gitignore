# Build output
/bin/
/dist/
/tmp/
/.tmp/

# Stray root-level deps (e.g. when a sub-package install resolves up here)
/node_modules/

# Local env / secrets / local DB
.env
*.db

# Frontend build output / deps (Phase 4)
/web/node_modules/

# Go
*.test
*.out
*.exe
__debug_bin*

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

/certs/

# Claude Code harness state (worktrees, local settings) - never commit
.claude/

# Internal project + AI-workflow docs (specs, plans, backlogs, reviews) -
# kept local, never published. The published VitePress site lives in docs/
# and IS tracked; the canonical OpenAPI spec stays at docs/openapi.yaml.
dev/

# VitePress build artifacts and local install (docs/ site is otherwise tracked).
docs/.vitepress/dist/
docs/.vitepress/cache/
docs/node_modules/
design/

# Playwright e2e outputs
/web/test-results/
/web/playwright-report/
/web/.playwright/

# Screenshot harness output (artifacts — the script is the deliverable)
/screenshots/
